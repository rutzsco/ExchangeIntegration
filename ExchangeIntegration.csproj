<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExchangeIntegration</RootNamespace>
    <AssemblyName>ExchangeIntegration</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- The test project lives in a sub-folder of this project, so keep its files out of this project's globs. -->
  <ItemGroup>
    <Compile Remove="ExchangeIntegration.Tests\**" />
    <EmbeddedResource Remove="ExchangeIntegration.Tests\**" />
    <None Remove="ExchangeIntegration.Tests\**" />
  </ItemGroup>

</Project>
